# ==========================================
# PRODUCTION .GITIGNORE FOR BODH GAYA QR & GUIDE
# ==========================================

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic / Runtime
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Dependencies
node_modules/
**/node_modules/

# Production builds & PWA / Vite Caches
dist/
**/dist/
dist-ssr
dev-dist/
**/dev-dist/
.vite/
**/.vite/
.eslintcache
.stylelintcache

# Environment variables & secrets (CRITICAL: Never commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
client/.env
client/.env.local
server/.env
server/.env.local
**/client/.env
**/server/.env
!.env.example
!client/.env.example
!server/.env.example

# Ephemeral dynamic server uploads & generated assets
server/public/uploads/
server/public/uploads/**/*
!server/public/uploads/.gitkeep
server/public/qrcodes/*.png
!server/public/qrcodes/.gitkeep

# Editor & OS files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Test coverage
coverage/
*.lcov
