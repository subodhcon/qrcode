# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# DATABASE CONFIGURATION (MongoDB Atlas / Local)
# ==========================================
# Local MongoDB:
MONGODB_URI="mongodb://127.0.0.1:27017/qrcode_db"
# MongoDB Atlas Cloud:
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/qrcode_db?retryWrites=true&w=majority"

# ==========================================
# JWT AUTHENTICATION (Admin Login)
# ==========================================
JWT_SECRET="your_super_secret_jwt_key_here"
JWT_EXPIRES_IN="24h"

# ==========================================
# MAP PROVIDER CONFIGURATION (osm / google)
# ==========================================
MAP_PROVIDER="osm"
# [PRESERVED: To switch back to Google Maps, set MAP_PROVIDER="google" and supply key]
# GOOGLE_PLACES_API_KEY="your_google_places_api_key_here"
GOOGLE_PLACES_API_KEY="your_google_places_api_key_here"

# ==========================================
# CLIENT / CORS
# ==========================================
CLIENT_URL="http://localhost:5173"

# ==========================================
# CLOUDINARY CONFIGURATION (Tourist Photos & ID Documents)
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
